# hwdef.dat for COBALT F405
MCU STM32F405 STM32F405xx
OSCILLATOR_HZ 8000000
APJ_BOARD_ID 1055

FLASH_SIZE_KB 1024
FLASH_RESERVE_START_KB 64
FLASH_BOOTLOADER_LOAD_KB 64
STORAGE_FLASH_PAGE 1
define HAL_STORAGE_SIZE 15360

# Flash Optimizations
define AP_SCRIPTING_ENABLED 0
define AP_AIRSPEED_ENABLED 0
define AP_WINCH_ENABLED 0
define AP_GRIPPER_ENABLED 0
define AP_BEACON_ENABLED 0

# USB Port & Serial Order
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

SERIAL_ORDER OTG1 USART1 USART2 USART3 UART4

# 1. SPI2: MPU6500 Gyro/Accel
PB12 MPU6500_CS CS
PB13 SPI2_SCK   SPI2
PB14 SPI2_MISO  SPI2
PB15 SPI2_MOSI  SPI2

SPIDEV mpu6500 SPI2 DEVID1 MPU6500_CS MODE3 1*MHZ 8*MHZ
IMU Invensense SPI:mpu6500 ROTATION_NONE

# 2. I2C1: BMP388 Barometer (Bus index 0)
PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1
I2C_ORDER I2C1
BARO BMP388 I2C:0:0x76
BARO BMP388 I2C:0:0x77

# External Compass on I2C1 (Socket J6)

# 3. 4 Motors (Timer 8)
PC7 TIM8_CH2 TIM8 PWM(1) GPIO(50) NODMA
PC9 TIM8_CH4 TIM8 PWM(2) GPIO(51) NODMA
PC6 TIM8_CH1 TIM8 PWM(3) GPIO(52) NODMA
PC8 TIM8_CH3 TIM8 PWM(4) GPIO(53) NODMA

# 4. UART1: MTF-01 Optical Flow and Lidar
PA9  USART1_TX USART1 NODMA
PA10 USART1_RX USART1 NODMA

# 5. UART2: SBUS Receiver
PA2 USART2_TX USART2
PA3 USART2_RX USART2

# 6. UART3: GPS Module (Socket J6: PC10/PC11)
PC10 USART3_TX USART3 NODMA
PC11 USART3_RX USART3 NODMA

# 7. UART4: Telemetry / Camera AI (PA0/PA1)
PA0 UART4_TX UART4 NODMA
PA1 UART4_RX UART4 NODMA

# 8. Buzzer
PA15 BUZZER OUTPUT LOW GPIO(80)
define HAL_BUZZER_PIN 80
define HAL_BUZZER_ON 1

# 9. ADC: Battery Voltage & Current
PC1 BAT_VOLT_PIN ADC1
PC2 BAT_CURR_PIN ADC1

define HAL_BATT_VOLT_PIN 11
define HAL_BATT_CURR_PIN 12
define HAL_BATT_VOLT_SCALE 14.47
define HAL_BATT_CURR_SCALE 38.87

define STM32F4xx_MCUCONF 1
undef AP_BOOTLOADER_FLASHING_ENABLED